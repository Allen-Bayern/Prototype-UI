---
export interface ApiPropRow {
  name: string;
  type: string;
  default?: string;
  description?: string;
}

export interface ApiPropsTableHeaders {
  name: string;
  type: string;
  default?: string;
  description?: string;
}

interface Props {
  headers: ApiPropsTableHeaders;
  rows: ApiPropRow[];
}

const { headers, rows } = Astro.props as Props;

const showDefault = headers.default !== undefined;
const showDescription = headers.description !== undefined;

function splitTypeParts(type: string): string[] {
  return type
    .split(/\s*\|\s*/)
    .map((part) => part.trim())
    .filter(Boolean);
}
---

<div class="api-props-table">
  <table>
    <thead>
      <tr>
        <th>{headers.name}</th>
        <th>{headers.type}</th>
        {showDefault && <th>{headers.default}</th>}
        {showDescription && <th>{headers.description}</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => {
          const typeParts = splitTypeParts(row.type);
          return (
            <tr>
              <td class="api-props-table__name">
                <code>{row.name}</code>
              </td>
              <td class="api-props-table__type">
                {typeParts.length > 1 ? (
                  <span class="api-props-table__union">
                    {typeParts.map((part, index) => (
                      <>
                        {index > 0 && (
                          <span class="api-props-table__sep" aria-hidden="true">
                            |
                          </span>
                        )}
                        <code>{part}</code>
                      </>
                    ))}
                  </span>
                ) : (
                  <code>{row.type}</code>
                )}
              </td>
              {showDefault && (
                <td class="api-props-table__default">
                  {row.default !== undefined ? <code>{row.default}</code> : '—'}
                </td>
              )}
              {showDescription && <td>{row.description ?? '—'}</td>}
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .api-props-table {
    overflow-x: auto;
  }

  .api-props-table__name {
    white-space: nowrap;
    width: 1%;
  }

  .api-props-table__union {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.3rem;
  }

  .api-props-table__sep {
    color: var(--color-muted-foreground);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    font-weight: 500;
    user-select: none;
  }

  .api-props-table__default {
    white-space: nowrap;
  }
</style>
