<style is:global>
  .dialog-demo-mask,
  .dialog-demo-content {
    transition: opacity 0.2s ease;
  }

  .dialog-demo-content {
    transition-property: opacity, scale;
  }

  .dialog-demo-mask[data-transition-state='closed'],
  .dialog-demo-mask[data-transition-state='leaving'],
  .dialog-demo-content[data-transition-state='closed'],
  .dialog-demo-content[data-transition-state='leaving'] {
    opacity: 0;
    pointer-events: none;
  }

  .dialog-demo-content[data-transition-state='closed'],
  .dialog-demo-content[data-transition-state='leaving'] {
    scale: 0.96;
  }

  .dialog-demo-mask[data-transition-state='entering'],
  .dialog-demo-mask[data-transition-state='entered'],
  .dialog-demo-content[data-transition-state='entering'],
  .dialog-demo-content[data-transition-state='entered'] {
    opacity: 1;
  }

  .dialog-demo-content[data-transition-state='entering'],
  .dialog-demo-content[data-transition-state='entered'] {
    scale: 1;
  }
</style>
