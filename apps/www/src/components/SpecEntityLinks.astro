---
import { getSpecEntityUrl } from '@/utils/spec-entity-links';

interface Props {
  files: string[];
  directory?: string;
}

const { files, directory } = Astro.props;
---

<ul>
  {
    files.map((file) => {
      const label = directory ? `${directory}/${file}` : file;
      return (
        <li>
          <a href={getSpecEntityUrl(file)}>{label}</a>
        </li>
      );
    })
  }
</ul>
