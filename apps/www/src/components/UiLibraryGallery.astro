---
type Locale = 'en' | 'zh-cn';
type LibraryId = 'base' | 'shadcn' | 'lucide' | 'brutalist';

interface Props {
  locale?: Locale;
}

type LibraryCard = {
  id: LibraryId;
  name: string;
  mark: string;
  type: string;
  status?: string;
  description: string;
  bestFor: string;
  sourceLabel: string;
  source: string;
  author: string;
  cta: string;
  href: string;
};

const { locale = 'en' } = Astro.props as Props;

const copy =
  locale === 'zh-cn'
    ? {
        aria: '选择一个 UI 原型库',
        count: '4 个可选库',
        componentCount: '3 个组件库',
        iconCount: '1 个图标库',
        bestFor: '适合',
        prototypeAuthor: '原型实现',
        cards: [
          {
            id: 'base',
            name: 'Base',
            mark: 'B',
            type: '协议型组件库',
            description: '克制、无预设风格，优先提供可跨宿主复用的交互语义。',
            bestFor: '自建设计体系、需要完整掌控视觉的产品',
            sourceLabel: '设计体系',
            source: 'Proto UI Base',
            author: 'Proto UI contributors',
            cta: '浏览 Base',
            href: './base/',
          },
          {
            id: 'shadcn',
            name: 'Shadcn',
            mark: 'sh',
            type: '风格组件库',
            description: '熟悉、清晰且实用的产品界面风格，建立在 Base 协议之上。',
            bestFor: '后台、SaaS 与希望快速获得成熟界面的产品',
            sourceLabel: '设计来源',
            source: 'shadcn/ui',
            author: 'Proto UI contributors',
            cta: '浏览 Shadcn',
            href: './shadcn/',
          },
          {
            id: 'lucide',
            name: 'Lucide',
            mark: '✦',
            type: '图标库',
            description: '轻量一致的线性图标，以逐图标入口提供可按需引入的原型。',
            bestFor: '需要统一图标语言与精细包体积控制的界面',
            sourceLabel: '图标来源',
            source: 'Lucide contributors',
            author: 'Proto UI contributors',
            cta: '浏览 Lucide',
            href: './lucide/',
          },
          {
            id: 'brutalist',
            name: 'Brutalist',
            mark: 'B!',
            type: '风格组件库',
            status: '孵化中',
            description: '强边框、硬阴影与高对比配色组成的 Neo-Brutalist 视觉投射。',
            bestFor: '创意工具、作品集与需要鲜明个性的产品',
            sourceLabel: '设计体系',
            source: 'Proto UI Neo-Brutalist',
            author: 'Proto UI contributors',
            cta: '浏览 Brutalist',
            href: './brutalist/',
          },
        ] satisfies LibraryCard[],
      }
    : {
        aria: 'Choose a UI prototype library',
        count: '4 libraries',
        componentCount: '3 component libraries',
        iconCount: '1 icon library',
        bestFor: 'Best for',
        prototypeAuthor: 'Prototype implementation',
        cards: [
          {
            id: 'base',
            name: 'Base',
            mark: 'B',
            type: 'Protocol components',
            description:
              'Restrained and unstyled, focused on reusable interaction semantics across hosts.',
            bestFor: 'Custom design systems and products that need full visual control',
            sourceLabel: 'Design system',
            source: 'Proto UI Base',
            author: 'Proto UI contributors',
            cta: 'Explore Base',
            href: './base/',
          },
          {
            id: 'shadcn',
            name: 'Shadcn',
            mark: 'sh',
            type: 'Styled components',
            description:
              'A familiar, crisp product UI language reconstructed on top of Base protocols.',
            bestFor: 'Dashboards, SaaS, and products that want a mature interface quickly',
            sourceLabel: 'Design source',
            source: 'shadcn/ui',
            author: 'Proto UI contributors',
            cta: 'Explore Shadcn',
            href: './shadcn/',
          },
          {
            id: 'lucide',
            name: 'Lucide',
            mark: '✦',
            type: 'Icon library',
            description:
              'A consistent line icon set exposed as tree-shakeable, per-icon prototypes.',
            bestFor: 'Interfaces that need a coherent icon language and precise bundle control',
            sourceLabel: 'Icon source',
            source: 'Lucide contributors',
            author: 'Proto UI contributors',
            cta: 'Explore Lucide',
            href: './lucide/',
          },
          {
            id: 'brutalist',
            name: 'Brutalist',
            mark: 'B!',
            type: 'Styled components',
            status: 'Incubating',
            description:
              'A Neo-Brutalist projection built from strong borders, hard shadows, and vivid contrast.',
            bestFor: 'Creative tools, portfolios, and products that want a distinct personality',
            sourceLabel: 'Design system',
            source: 'Proto UI Neo-Brutalist',
            author: 'Proto UI contributors',
            cta: 'Explore Brutalist',
            href: './brutalist/',
          },
        ] satisfies LibraryCard[],
      };
---

<section class="library-gallery" aria-label={copy.aria}>
  <div class="library-gallery__summary" aria-label={copy.count}>
    <span>{copy.count}</span>
    <span>{copy.componentCount}</span>
    <span>{copy.iconCount}</span>
  </div>

  <div class="library-gallery__grid">
    {
      copy.cards.map((library) => (
        <article class:list={['library-card', `library-card--${library.id}`]}>
          <a class="library-card__link" href={library.href} aria-label={library.cta}>
            <header class="library-card__header">
              <span class="library-card__logo" aria-hidden="true">
                {library.mark}
              </span>
              <span class="library-card__identity">
                <strong>{library.name}</strong>
                <span>{library.type}</span>
              </span>
              {library.status && <span class="library-card__status">{library.status}</span>}
            </header>

            <div class="library-card__preview" aria-hidden="true">
              {library.id === 'base' && (
                <div class="base-preview">
                  <div class="base-preview__toolbar">
                    <i />
                    <i />
                    <i />
                  </div>
                  <div class="base-preview__body">
                    <div class="base-preview__title" />
                    <div class="base-preview__copy" />
                    <div class="base-preview__row">
                      <span class="base-preview__field" />
                      <span class="base-preview__switch">
                        <i />
                      </span>
                    </div>
                    <div class="base-preview__actions">
                      <span />
                      <span />
                    </div>
                  </div>
                </div>
              )}

              {library.id === 'shadcn' && (
                <div class="shadcn-preview">
                  <div class="shadcn-preview__nav">
                    <i />
                    <span />
                    <span />
                    <b />
                  </div>
                  <div class="shadcn-preview__panel">
                    <div class="shadcn-preview__title" />
                    <div class="shadcn-preview__copy" />
                    <div class="shadcn-preview__fields">
                      <span />
                      <span />
                    </div>
                    <div class="shadcn-preview__button" />
                  </div>
                </div>
              )}

              {library.id === 'lucide' && (
                <div class="lucide-preview">
                  <div class="lucide-preview__search">
                    <span class="lucide-preview__magnifier" />
                    <i />
                  </div>
                  <div class="lucide-preview__icons">
                    <span class="line-icon line-icon--sun" />
                    <span class="line-icon line-icon--check" />
                    <span class="line-icon line-icon--heart" />
                    <span class="line-icon line-icon--sparkle">✦</span>
                    <span class="line-icon line-icon--arrow">↗</span>
                    <span class="line-icon line-icon--command">⌘</span>
                  </div>
                </div>
              )}

              {library.id === 'brutalist' && (
                <div class="brutalist-preview">
                  <div class="brutalist-preview__poster">
                    <span class="brutalist-preview__sticker">NEW</span>
                    <strong>
                      BUILD
                      <br />
                      LOUD.
                    </strong>
                    <div class="brutalist-preview__controls">
                      <span>SELECT</span>
                      <i />
                    </div>
                  </div>
                  <div class="brutalist-preview__dot" />
                </div>
              )}
            </div>

            <div class="library-card__body">
              <p class="library-card__description">{library.description}</p>
              <p class="library-card__best-for">
                <span>{copy.bestFor}</span>
                {library.bestFor}
              </p>
              <dl class="library-card__credits">
                <div>
                  <dt>{library.sourceLabel}</dt>
                  <dd>{library.source}</dd>
                </div>
                <div>
                  <dt>{copy.prototypeAuthor}</dt>
                  <dd>{library.author}</dd>
                </div>
              </dl>
            </div>

            <footer class="library-card__footer">
              <span>{library.cta}</span>
              <span aria-hidden="true">↗</span>
            </footer>
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .library-gallery {
    margin-block: 1.75rem 3rem;
  }

  .library-gallery__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .library-gallery__summary span {
    border: 1px solid color-mix(in oklab, var(--color-border) 88%, transparent);
    border-radius: 999px;
    color: var(--color-muted-foreground);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    line-height: 1;
    padding: 0.4rem 0.65rem;
  }

  .library-gallery__summary span:first-child {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .library-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .library-card {
    min-width: 0;
    margin: 0;
    border: 1px solid color-mix(in oklab, var(--color-border) 88%, transparent);
    border-radius: 0.85rem;
    background: color-mix(in oklab, var(--color-background) 97%, var(--color-muted) 3%);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-foreground) 5%, transparent);
    overflow: hidden;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .library-card:hover,
  .library-card:focus-within {
    border-color: color-mix(in oklab, var(--color-foreground) 35%, var(--color-border));
    box-shadow:
      0 14px 32px color-mix(in oklab, var(--color-foreground) 8%, transparent),
      0 1px 0 color-mix(in oklab, var(--color-foreground) 8%, transparent);
    transform: translateY(-2px);
  }

  .library-card__link {
    display: grid;
    height: 100%;
    color: inherit;
    grid-template-rows: auto auto 1fr auto;
    text-decoration: none;
  }

  .library-card__link:focus-visible {
    border-radius: 0.75rem;
    outline: 2px solid var(--color-primary);
    outline-offset: -3px;
  }

  .library-card__header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.9rem 0.9rem 0.8rem;
  }

  .library-card__logo {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--color-border) 88%, transparent);
    border-radius: 0.62rem;
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .library-card--shadcn .library-card__logo {
    background: #18181b;
    color: #fafafa;
    text-transform: lowercase;
  }

  .library-card--lucide .library-card__logo {
    background: #f56565;
    border-color: #f56565;
    color: #fff;
    font-size: 1rem;
  }

  .library-card--brutalist .library-card__logo {
    border: 2px solid #111;
    border-radius: 0;
    background: #ffd23f;
    box-shadow: 2px 2px 0 #111;
    color: #111;
  }

  .library-card__identity {
    display: grid;
    min-width: 0;
    gap: 0.08rem;
  }

  .library-card__identity strong {
    color: var(--color-foreground);
    font-size: 0.98rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .library-card__identity > span {
    color: var(--color-muted-foreground);
    font-size: 0.7rem;
    line-height: 1.25;
  }

  .library-card__status {
    margin-left: auto;
    border: 1px solid color-mix(in oklab, #f59e0b 60%, var(--color-border));
    border-radius: 999px;
    background: color-mix(in oklab, #f59e0b 12%, var(--color-background));
    color: color-mix(in oklab, #b45309 82%, var(--color-foreground));
    font-size: 0.63rem;
    font-weight: 750;
    letter-spacing: 0.025em;
    line-height: 1;
    padding: 0.34rem 0.48rem;
    white-space: nowrap;
  }

  .library-card__preview {
    position: relative;
    min-height: 13.5rem;
    margin-inline: 0.75rem;
    overflow: hidden;
    border-radius: 0.62rem;
  }

  .library-card__body {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: 1rem 0.95rem 0.9rem;
  }

  .library-card__description,
  .library-card__best-for {
    margin: 0;
  }

  .library-card__description {
    color: var(--color-foreground);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .library-card__best-for {
    color: var(--color-muted-foreground);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .library-card__best-for span {
    margin-right: 0.4rem;
    color: var(--color-foreground);
    font-weight: 700;
  }

  .library-card__credits {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-top: 0.15rem;
  }

  .library-card__credits div {
    display: grid;
    grid-template-columns: minmax(5.6rem, 0.9fr) minmax(0, 1.2fr);
    gap: 0.6rem;
  }

  .library-card__credits dt,
  .library-card__credits dd {
    margin: 0;
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .library-card__credits dt {
    color: var(--color-muted-foreground);
  }

  .library-card__credits dd {
    overflow: hidden;
    color: var(--color-foreground);
    font-weight: 650;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-card__footer {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid color-mix(in oklab, var(--color-border) 78%, transparent);
    color: var(--color-foreground);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.72rem 0.95rem;
  }

  .library-card__footer span:last-child {
    transition: transform 180ms ease;
  }

  .library-card:hover .library-card__footer span:last-child {
    transform: translate(2px, -2px);
  }

  /* Base preview */
  .library-card--base .library-card__preview {
    display: grid;
    place-items: center;
    background:
      linear-gradient(color-mix(in oklab, #e5e7eb 62%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, #e5e7eb 62%, transparent) 1px, transparent 1px),
      #f8fafc;
    background-size: 18px 18px;
  }

  .base-preview {
    width: 78%;
    border: 1px solid #cbd5e1;
    border-radius: 0.55rem;
    background: #fff;
    box-shadow: 0 14px 28px rgba(15, 23, 42, 0.1);
    color: #0f172a;
    transform: rotate(-1deg);
  }

  .base-preview__toolbar {
    display: flex;
    gap: 0.3rem;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.52rem 0.62rem;
  }

  .base-preview__toolbar i {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .base-preview__body {
    display: grid;
    gap: 0.72rem;
    padding: 1rem;
  }

  .base-preview__title,
  .base-preview__copy,
  .base-preview__field,
  .base-preview__actions span {
    display: block;
    border-radius: 0.16rem;
    background: #0f172a;
  }

  .base-preview__title {
    width: 42%;
    height: 0.48rem;
  }

  .base-preview__copy {
    width: 76%;
    height: 0.25rem;
    background: #cbd5e1;
  }

  .base-preview__row,
  .base-preview__actions {
    display: flex;
    align-items: center;
  }

  .base-preview__row {
    justify-content: space-between;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding-block: 0.7rem;
  }

  .base-preview__field {
    width: 36%;
    height: 0.26rem;
    background: #94a3b8;
  }

  .base-preview__switch {
    display: flex;
    width: 1.75rem;
    height: 0.95rem;
    justify-content: flex-end;
    align-items: center;
    border-radius: 999px;
    background: #0f172a;
    padding: 0.12rem;
  }

  .base-preview__switch i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #fff;
  }

  .base-preview__actions {
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .base-preview__actions span {
    width: 2.7rem;
    height: 1.1rem;
    border: 1px solid #cbd5e1;
    background: transparent;
  }

  .base-preview__actions span:last-child {
    border-color: #0f172a;
    background: #0f172a;
  }

  /* Shadcn preview */
  .library-card--shadcn .library-card__preview {
    background: #e4e4e7;
    color: #18181b;
  }

  .shadcn-preview {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 83% 15%, rgba(255, 255, 255, 0.9), transparent 30%), #e4e4e7;
    padding: 1rem;
  }

  .shadcn-preview__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .shadcn-preview__nav i {
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 0.25rem;
    background: #18181b;
  }

  .shadcn-preview__nav span {
    width: 2.4rem;
    height: 0.23rem;
    border-radius: 999px;
    background: #a1a1aa;
  }

  .shadcn-preview__nav b {
    width: 2.7rem;
    height: 1.05rem;
    margin-left: auto;
    border-radius: 0.3rem;
    background: #18181b;
  }

  .shadcn-preview__panel {
    display: grid;
    width: 72%;
    gap: 0.65rem;
    margin: 1.3rem auto 0;
    border: 1px solid #d4d4d8;
    border-radius: 0.58rem;
    background: #fff;
    box-shadow: 0 16px 36px rgba(24, 24, 27, 0.18);
    padding: 1rem;
  }

  .shadcn-preview__title,
  .shadcn-preview__copy,
  .shadcn-preview__fields span,
  .shadcn-preview__button {
    display: block;
    border-radius: 0.18rem;
  }

  .shadcn-preview__title {
    width: 52%;
    height: 0.46rem;
    background: #18181b;
  }

  .shadcn-preview__copy {
    width: 86%;
    height: 0.24rem;
    background: #d4d4d8;
  }

  .shadcn-preview__fields {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.15rem;
  }

  .shadcn-preview__fields span {
    height: 1.25rem;
    border: 1px solid #d4d4d8;
    background: #fafafa;
  }

  .shadcn-preview__button {
    width: 3.2rem;
    height: 1.15rem;
    margin-left: auto;
    background: #18181b;
  }

  /* Lucide preview */
  .library-card--lucide .library-card__preview {
    background: #fff4f3;
    color: #2e2a2a;
  }

  .lucide-preview {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.9rem;
    padding: 1rem;
  }

  .lucide-preview__search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 1.7rem;
    border: 1px solid #f1c2bf;
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.75);
    padding-inline: 0.55rem;
  }

  .lucide-preview__search i {
    width: 38%;
    height: 0.23rem;
    border-radius: 999px;
    background: #e8b1ad;
  }

  .lucide-preview__magnifier {
    position: relative;
    width: 0.65rem;
    height: 0.65rem;
    border: 1.5px solid #8f5d5a;
    border-radius: 50%;
  }

  .lucide-preview__magnifier::after {
    position: absolute;
    right: -0.27rem;
    bottom: -0.2rem;
    width: 0.34rem;
    height: 1.5px;
    background: #8f5d5a;
    content: '';
    rotate: 45deg;
  }

  .lucide-preview__icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
  }

  .line-icon {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    border: 1px solid #f1cfcc;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.72);
    color: #70413e;
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-style: normal;
    line-height: 1;
  }

  .line-icon--sun::before {
    width: 1rem;
    height: 1rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    box-shadow:
      0 -0.48rem 0 -0.4rem currentColor,
      0 0.48rem 0 -0.4rem currentColor,
      0.48rem 0 0 -0.4rem currentColor,
      -0.48rem 0 0 -0.4rem currentColor;
    content: '';
  }

  .line-icon--check::before {
    width: 1.1rem;
    height: 1.1rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    content: '';
  }

  .line-icon--check::after {
    position: absolute;
    width: 0.48rem;
    height: 0.24rem;
    border-bottom: 1.5px solid currentColor;
    border-left: 1.5px solid currentColor;
    content: '';
    rotate: -45deg;
    translate: 0 -0.05rem;
  }

  .line-icon--heart::before {
    content: '♡';
    font-family: sans-serif;
    font-size: 1.75rem;
    font-weight: 300;
  }

  /* Brutalist preview */
  .library-card--brutalist .library-card__preview {
    background: #a7f3d0;
